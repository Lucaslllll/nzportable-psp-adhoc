# Fontes fixadas deste build. Ambos os scripts leem este arquivo.
# Pinned sources for this build. Both scripts read this file.

# --- Engine (fork) ---
ENGINE_REPO="https://github.com/Lucaslllll/vril-engine.git"
ENGINE_BRANCH="feature/psp-adhoc-multiplayer"
ENGINE_COMMIT="a99d067d9abb9509795c0243dc54807c43e1d26c"

# --- QuakeC (fork) ---
QUAKEC_REPO="https://github.com/Lucaslllll/quakec.git"
QUAKEC_BRANCH="feature/standard-coop-spawn"
QUAKEC_COMMIT="bc4c34397a7aec040c86bf22b8a1fab309def126"

# --- Dados do jogo: nightly oficial do nzp-team (NAO redistribuido aqui) ---
GAMEDATA_REPO="nzp-team/nzportable"
GAMEDATA_TAG="nightly"
GAMEDATA_ASSET="nzportable-psp.zip"
GAMEDATA_VERSION_ASSET="build-version.txt"

# --- Releases deste repositorio (EBOOT.PBP + progs.dat + checksums) ---
RELEASE_REPO="Lucaslllll/nzportable-psp-adhoc"

# --- Toolchain PSP ---
# Releases do pspdev mais novas que ~v20250801 sao compiladas em Debian 13 e
# quebram com "GLIBC_2.38 not found" em sistemas com glibc antiga (Debian 12).
PSPDEV_REPO="pspdev/pspdev"
PSPDEV_GLIBC_MIN="2.38"
PSPDEV_FALLBACK_TAG="v20250701"
